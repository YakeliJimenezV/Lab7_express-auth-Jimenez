    {
      "name": "11 - ADMIN lista usuarios",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Lista sin hashes\", function () { const users = pm.response.json(); pm.expect(users).to.be.an(\"array\"); users.forEach(function (user) { pm.expect(user).not.to.have.property(\"password\"); }); });"
            ]
          }
        }
      ]
