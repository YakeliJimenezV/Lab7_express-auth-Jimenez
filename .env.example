# Copiar a .env solo si no existe. Nunca subir .env ni valores reales.
NODE_ENV=development
PORT=3000
# Local: conservar el nombre de la base del laboratorio 07.
MONGO_URI=mongodb://127.0.0.1:27017/<BASE_EXISTENTE>
# Render: configurar privadamente la URI de Atlas, incluyendo la base de datos.
# MONGO_URI=mongodb+srv://<USUARIO_DB>:<PASSWORD_URL_ENCODED>@<CLUSTER>/<BASE_EXISTENTE>?retryWrites=true&w=majority
# Generar un valor aleatorio de al menos 32 caracteres antes de arrancar.
JWT_SECRET=
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=10
# El administrador existente se conserva. Habilitar solo para crear uno nuevo.
SEED_ADMIN=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
